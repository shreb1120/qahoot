# ── Flask ─────────────────────────────────────────────────────────────────────
# Used to sign session cookies. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-with-a-random-urlsafe-string

# ── Database ───────────────────────────────────────────────────────────────────
# Format: postgresql://USER:PASSWORD@HOST/DBNAME
# Local dev example (matches the Postgres setup in the Phase 1 docs):
DATABASE_URL=postgresql://qahoot:qahoot_dev@localhost/qahoot_dev

# ── Clerk (auth) ───────────────────────────────────────────────────────────────
# Get these from your Clerk dashboard → API Keys.
# Publishable key starts with pk_test_ (dev) or pk_live_ (prod).
CLERK_PUBLISHABLE_KEY=pk_test_replace_me

# JWKS URL: in Clerk dashboard → API Keys → Advanced → JWT public key URL.
# Format: https://<your-clerk-frontend-api>/.well-known/jwks.json
CLERK_JWKS_URL=https://your-clerk-frontend-api/.well-known/jwks.json

# ── AssemblyAI + Anthropic (required for Phase 2 call analysis) ────────────────
ASSEMBLYAI_API_KEY=your_assemblyai_key_here
ANTHROPIC_API_KEY=your_anthropic_key_here

# ── Server ─────────────────────────────────────────────────────────────────────
# HOST=127.0.0.1
# PORT=5000
# THREADS=8

# Set to "true" if a TLS-terminating reverse proxy sits in front of the app.
# Adds Secure flag to cookies and sends HSTS. Required in Phase 4.
# SESSION_COOKIE_SECURE=false

# ── Stripe (billing) ───────────────────────────────────────────────────────────
# Test keys until you are ready to charge real cards. Everything works against
# sk_test_ — Checkout, the portal, webhooks — with no money moving.
# Create the products and prices with: python3 scripts/stripe_setup.py
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PRICE_SOLO=price_...
# STRIPE_PRICE_STARTER=price_...
# STRIPE_PRICE_GROWTH=price_...

# ── Vendor cost (margin reporting only) ────────────────────────────────────────
# Your AssemblyAI rate per hour of audio, from their dashboard. Used to fill in
# usage_events.vendor_cost_micros. Left unset, cost reporting reads zero rather
# than guessing.
# ASSEMBLYAI_COST_PER_HOUR=0.00
