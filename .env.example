ASSEMBLYAI_API_KEY=your_assemblyai_key_here
ANTHROPIC_API_KEY=your_anthropic_key_here

# Shared password your team types into the login screen.
# Use a long random string. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(18))"
APP_PASSWORD=set-a-strong-shared-password

# Used to sign session cookies. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-with-a-random-urlsafe-string

# --- Network / LAN controls --------------------------------------------------
# Interface to bind. Default 127.0.0.1 (loopback only). To serve the LAN, set
# this to the server's specific LAN IP (e.g. 192.168.1.50). Avoid 0.0.0.0.
# HOST=192.168.1.50
# PORT=5000
# THREADS=8

# IP allowlist enforced inside the Flask app (defense in depth, in addition to
# the Windows Firewall rule). Comma-separated CIDRs. Default = RFC1918 +
# loopback + link-local + IPv6 ULA. Tighten to your office subnet if you can.
# LAN_ALLOWED_CIDRS=192.168.1.0/24,127.0.0.1/32

# Set to "true" only for local debugging. Disables the app-level LAN check.
# LAN_CHECK_DISABLED=false

# Set to "true" if you put a TLS-terminating reverse proxy in front of the app.
# When true, the session cookie gets the Secure flag and HSTS is sent.
# SESSION_COOKIE_SECURE=false
